# Сначала запустите backend/init-env.sh (macOS/Linux) или backend/init-env.ps1 (Windows).
# Скрипт создаёт случайные секреты в локальном .env и сохраняет существующие настройки БД.
DB_NAME=repairly
DB_USER=repairly
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_INIT_SCRIPT
DB_PORT=55434
DB_URL=jdbc:postgresql://localhost:55434/repairly
JWT_SECRET_BASE64=GENERATE_48_RANDOM_BYTES_IN_BASE64
BOOTSTRAP_ADMIN_EMAIL=admin@repairly.local
BOOTSTRAP_ADMIN_NAME=Repairly Administrator
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_GENERATE_WITH_INIT_SCRIPT
APP_PORT=8080
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
PERMANENT_DELETE_ENABLED=true
# При смене APP_PORT задайте соответствующий origin:
CORS_ALLOWED_ORIGINS=http://localhost:8080
