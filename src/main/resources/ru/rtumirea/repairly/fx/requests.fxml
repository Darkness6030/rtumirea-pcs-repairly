<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.rtumirea.repairly.fx.controller.RequestsController" spacing="12">
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Заявки на ремонт" styleClass="page-title"/>
            <Label text="От первого обращения до исправной техники" styleClass="muted"/>
        </VBox>
        <Button fx:id="addButton" text="+  Новая заявка" styleClass="primary" onAction="#add"/>
    </HBox>
    <VBox styleClass="filter-panel" spacing="10">
        <HBox spacing="10">
            <TextField fx:id="search" promptText="Поиск: техника, клиент, телефон, неисправность…" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="statusFilter" prefWidth="180"/>
            <ComboBox fx:id="technicianFilter" prefWidth="185"/>
        </HBox>
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <Label text="Дата приёма" styleClass="muted"/>
            <DatePicker fx:id="fromDate" promptText="С даты" prefWidth="140"/>
            <Label text="—" styleClass="muted"/>
            <DatePicker fx:id="toDate" promptText="По дату" prefWidth="140"/>
            <Button text="Сбросить" onAction="#clearFilters" styleClass="quiet"/>
            <Label fx:id="linkedFilter" styleClass="accent-text" wrapText="true"/>
        </FlowPane>
        <Label fx:id="filterError" styleClass="error" wrapText="true" minHeight="0"/>
    </VBox>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="count" text="Показано 0 из 0" styleClass="section-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="editButton" text="Редактировать" onAction="#edit"/>
        <Button fx:id="deleteButton" text="Удалить" styleClass="danger" onAction="#delete"/>
        <Button fx:id="exportButton" text="Экспорт CSV" onAction="#export"/>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.62" VBox.vgrow="ALWAYS" styleClass="content-split">
        <TableView fx:id="table" minHeight="130"/>
        <VBox spacing="8" styleClass="detail-panel" minHeight="175">
            <Label fx:id="detailTitle" styleClass="section-title" wrapText="true"/>
            <HBox spacing="24">
                <Label fx:id="detailClient" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefWidth="360"/>
                <Label fx:id="detailTechnician" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefWidth="360"/>
            </HBox>
            <TextArea fx:id="detailProblem" editable="false" wrapText="true" prefRowCount="2" minHeight="45" VBox.vgrow="ALWAYS" styleClass="readonly" promptText="Описание неисправности"/>
            <Label fx:id="detailDates" styleClass="muted" wrapText="true"/>
        </VBox>
    </SplitPane>
</VBox>
